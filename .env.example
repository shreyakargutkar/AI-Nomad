# Live Context Engine — optional API keys (copy to project root .env)

# Required for live weather + city-local time (OpenWeatherMap)
WEATHER_API_KEY=

# Recommended for real nearby places (Google Cloud — enable Places API)
GOOGLE_PLACES_API_KEY=
# alias:
# GOOGLE_MAPS_API_KEY=

# AI explanations — at least one recommended
GROQ_API_KEY=
GEMINI_API_KEY=

# Itinerary live research (Tavily web search + Groq formatting)
TAVILY_API_KEY=
DEFAULT_PASSPORT_COUNTRY=India

# Force place provider: auto | google | osm (default: auto)
# PLACES_PROVIDER=auto
